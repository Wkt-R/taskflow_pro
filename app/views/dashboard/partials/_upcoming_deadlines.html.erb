<div class="bg-gray-800 rounded-2xl p-6 border border-gray-700 shadow-lg">
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-semibold text-white">Upcoming Deadlines</h2>
    <span class="text-gray-400 text-sm"><%= @due_soon_tasks.count %> tasks due soon</span>
  </div>
  
  <div class="space-y-3">
    <% if @due_soon_tasks.any? %>
      <% @due_soon_tasks.each do |task| %>
        <div class="flex items-center justify-between p-3 bg-gray-750 rounded-lg border border-yellow-500/30">
          <div class="flex items-center space-x-3 flex-1">
            <div class="w-8 h-8 bg-yellow-500/20 rounded-lg flex items-center justify-center">
              <svg class="h-4 w-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="flex-1">
              <h4 class="text-white text-sm font-medium"><%= task.title %></h4>
              <p class="text-gray-400 text-xs">Due <%= task.duedate.strftime("%b %d") %> • <%= task.project.name %></p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium <%= task.status_badge_color %> text-white">
              <%= task.status.humanize %>
            </span>
            <%= link_to "Jump", project_path(task.project), 
                class: "bg-yellow-500 hover:bg-yellow-400 text-white px-2 py-1 rounded text-xs font-medium transition-colors",
                title: "Go to task" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-6">
        <svg class="mx-auto h-12 w-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="mt-2 text-gray-400">No upcoming deadlines</p>
      </div>
    <% end %>
  </div>

  <% if @overdue_tasks.any? %>
    <div class="mt-6 pt-6 border-t border-gray-700">
      <h3 class="text-lg font-semibold text-red-400 mb-4">Overdue Tasks</h3>
      <div class="space-y-3">
        <% @overdue_tasks.each do |task| %>
          <div class="flex items-center justify-between p-3 bg-red-500/10 rounded-lg border border-red-500/30">
            <div class="flex items-center space-x-3 flex-1">
              <div class="w-8 h-8 bg-red-500/20 rounded-lg flex items-center justify-center">
                <svg class="h-4 w-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h4 class="text-white text-sm font-medium"><%= task.title %></h4>
                <p class="text-red-400 text-xs">Overdue since <%= task.duedate.strftime("%b %d") %></p>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <%= link_to "Jump", project_task_path(task.project, task), 
                  class: "bg-red-500 hover:bg-red-400 text-white px-2 py-1 rounded text-xs font-medium transition-colors",
                  title: "Go to task" %>
              <%= link_to "Project", project_path(task.project), 
                  class: "bg-gray-600 hover:bg-gray-500 text-white px-2 py-1 rounded text-xs font-medium transition-colors",
                  title: "View project" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>