<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700 shadow-lg">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-400 text-sm font-medium">Total Projects</p>
        <p class="text-3xl font-bold text-white mt-2"><%= @total_projects %></p>
      </div>
      <div class="p-3 bg-blue-500/10 rounded-xl">
        <svg class="h-6 w-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700 shadow-lg">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-400 text-sm font-medium">Total Tasks</p>
        <p class="text-3xl font-bold text-white mt-2"><%= @total_tasks %></p>
      </div>
      <div class="p-3 bg-green-500/10 rounded-xl">
        <svg class="h-6 w-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700 shadow-lg">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-400 text-sm font-medium">Completed Tasks</p>
        <p class="text-3xl font-bold text-white mt-2"><%= @completed_tasks %></p>
      </div>
      <div class="p-3 bg-purple-500/10 rounded-xl">
        <svg class="h-6 w-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700 shadow-lg">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-gray-400 text-sm font-medium">Completion Rate</p>
        <p class="text-3xl font-bold text-white mt-2"><%= @completion_rate %>%</p>
      </div>
      <div class="p-3 bg-yellow-500/10 rounded-xl">
        <svg class="h-6 w-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
        </svg>
      </div>
    </div>
  </div>
</div>