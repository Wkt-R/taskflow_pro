<div class="min-h-screen bg-gradient-to-br from-gray-900 to-gray-800 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <%= render 'dashboard/partials/header' %>
    
    <%= render 'dashboard/partials/stats_grid' %>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">
        <%= render 'dashboard/partials/recent_projects' %>
        
        <%= render 'dashboard/partials/upcoming_deadlines' %>
      </div>

      <div class="space-y-8">
        <%= render 'dashboard/partials/quick_stats' %>
        
        <%= render 'dashboard/partials/recent_activity' %>
        
        \<%= render 'dashboard/partials/quick_actions' %>
      </div>
    </div>
  </div>
</div>