<!DOCTYPE html>
<html>
  <head>
    <title>TaskFlow Pro</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="bg-gray-900 min-h-screen">
     <% if user_signed_in? %>
      <nav class="bg-gray-800 border-b border-gray-700 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center">
              <div class="flex-shrink-0 flex items-center">
                <div class="h-8 w-8 bg-gradient-to-r from-green-400 to-yellow-400 rounded-lg flex items-center justify-center mr-3">
                  <span class="text-gray-900 font-bold text-sm">T</span>
                </div>
                <%= link_to "TaskFlow Pro", "/", class: "text-xl font-bold text-white hover:text-green-400 transition-colors" %>
              </div>
              <div class="hidden md:ml-6 md:flex md:space-x-4">
                <%= link_to "Dashboard", "/", class: "text-gray-300 hover:text-yellow-400 transition-colors duration-200 px-3 py-2 rounded-md text-sm font-medium" %>
                <%= link_to "Projects", "/projects", class: "text-gray-300 hover:text-yellow-400 transition-colors duration-200 px-3 py-2 rounded-md text-sm font-medium" %>
              </div>
            </div>
            <div class="flex items-center space-x-6">
              <span class="text-gray-300">Welcome back, <span class="text-green-400 font-medium"><%= current_user.first_name %></span></span>
              <%= link_to "Edit Profile", "/users/edit", class: "text-gray-300 hover:text-yellow-400 transition-colors duration-200 text-sm" %>
              <%= button_to "Sign Out", "/users/sign_out", method: :delete, class: "bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 shadow-lg" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice %>
      <div class="bg-gradient-to-r from-green-900 to-green-800 border border-green-600 text-green-100 px-6 py-4 rounded-lg mx-4 mt-4 shadow-lg" role="alert">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium"><%= notice %></p>
          </div>
        </div>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="bg-gradient-to-r from-yellow-900 to-yellow-800 border border-yellow-600 text-yellow-100 px-6 py-4 rounded-lg mx-4 mt-4 shadow-lg" role="alert">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium"><%= alert %></p>
          </div>
        </div>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>
  </body>
</html>