<% if @project.tasks.any? %>
  <div class="<%= card_classes %>">
    <div class="flex justify-between items-center mb-2">
      <span class="text-sm font-medium text-gray-300">Project Progress</span>
      <span class="text-sm font-medium text-green-400 progress-percentage">
        <%= @project.progress_percentage %>%
      </span>
    </div>
    <div class="w-full bg-gray-700 rounded-full h-2 mb-2">
      <div class="bg-green-500 h-2 rounded-full transition-all duration-500 ease-out" 
           data-task-status-target="progressBar"
           style="width: <%= @project.progress_percentage %>%">
        <span class="sr-only"><%= @project.progress_percentage %>% Complete</span>
      </div>
    </div>
    <div class="flex justify-between text-xs text-gray-400">
      <span>
        <span data-task-status-target="completedCount"><%= @project.completed_tasks_count %></span> 
        of 
        <span data-task-status-target="totalCount"><%= @project.tasks.count %></span> 
        tasks completed
      </span>
    </div>
  </div>
<% end %>