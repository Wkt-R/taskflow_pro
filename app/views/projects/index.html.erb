<div class="min-h-screen bg-gradient-to-br from-gray-900 to-gray-800 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white">Your Projects</h1>
        <p class="text-gray-400 mt-2">Manage and track all your projects in one place</p>
      </div>
      <%= link_to new_project_path, class: "bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-6 py-3 rounded-lg font-medium transition-all duration-200 transform hover:scale-105 shadow-lg flex items-center space-x-2" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span>New Project</span>
      <% end %>
    </div>

    <% if @projects.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @projects.each do |project| %>
          <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700 hover:border-green-500 transition-all duration-300 transform hover:-translate-y-1 shadow-lg group">

            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-semibold text-white group-hover:text-green-400 transition-colors">
                <%= link_to project.name, project, class: "hover:underline" %>
              </h3>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= project.status_badge_color %> text-white">
                <%= project.status.humanize %>
              </span>
            </div>

            <% if project.description.present? %>
              <p class="text-gray-300 mb-4 line-clamp-3"><%= project.description %></p>
            <% else %>
              <p class="text-gray-500 mb-4 italic">No description provided</p>
            <% end %>

            <div class="flex items-center justify-between text-sm text-gray-400 mb-4">
              <span>Created <%= time_ago_in_words(project.created_at) %> ago</span>
              <span><%= project.days_since_created %> days</span>
            </div>

            <div class="flex space-x-2">
              <%= link_to 'View', "/projects/#{project.id}", class: "flex-1 bg-gray-700 hover:bg-gray-600 text-white text-center py-2 px-4 rounded-lg transition-colors" %>
              <%= link_to 'Edit', "/projects/#{project.id}/edit", class: "flex-1 bg-blue-600 hover:bg-blue-500 text-white text-center py-2 px-4 rounded-lg transition-colors" %>
              <%= button_to 'Delete', "/projects/#{project.id}", method: :delete, form: { class: "flex-1", data: { turbo_confirm: "Are you sure you want to delete this project?" } }, class: "bg-red-600 hover:bg-red-500 text-white w-full py-2 px-4 rounded-lg transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>

      <div class="text-center py-12">
        <div class="bg-gray-800 rounded-2xl p-12 border border-gray-700 border-dashed">
          <svg class="mx-auto h-12 w-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <h3 class="mt-4 text-lg font-medium text-white">No projects yet</h3>
          <p class="mt-2 text-gray-400">Get started by creating your first project.</p>
          <div class="mt-6">
            <%= link_to new_project_path, class: "bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-6 py-3 rounded-lg font-medium transition-all duration-200 transform hover:scale-105 shadow-lg inline-flex items-center space-x-2" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <span>Create Project</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>