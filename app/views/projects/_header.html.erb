<div class="flex justify-between items-start mb-8">
  <div>
    <h1 class="text-3xl font-bold text-white"><%= @project.name %></h1>
    <div class="flex items-center space-x-4 mt-2">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= status_badge_color(@project.status) %> text-white">
        <%= @project.status.humanize %>
      </span>
      <span class="text-gray-400 text-sm">Created <%= time_ago_in_words(@project.created_at) %> ago</span>
    </div>
  </div>
  <div class="flex space-x-3">
    <%= link_to 'Edit', edit_project_path(@project), class: button_classes(variant: :secondary) %>
    <%= link_to 'Back to Projects', projects_path, class: button_classes(variant: :secondary) %>
  </div>
</div>