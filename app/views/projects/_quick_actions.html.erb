<div class="<%= card_classes %>">
  <h3 class="text-lg font-semibold text-white mb-4">Quick Actions</h3>
  <div class="space-y-3">
    <%= link_to new_project_task_path(@project), class: "w-full #{button_classes(variant: :primary)} text-center block" do %>
      Add Task
    <% end %>
    
    <button class="w-full <%= button_classes(variant: :secondary) %>">
      Share Project
    </button>
    
    <%= button_to "Export Project Report", export_project_path(@project), 
          class: "w-full #{button_classes}" %>
  </div>
</div>