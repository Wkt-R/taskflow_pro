<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <h1>Project Report: <%= @project.name %></h1>
    
    <p>Hello <%= @user.first_name %>,</p>
    
    <p>Here is your project report for <strong><%= @project.name %></strong>:</p>
    
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;">
      <h2 style="margin-top: 0;">Project Overview</h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
        <div style="background: white; padding: 15px; border-radius: 6px; border-left: 4px solid #007bff;">
          <strong>Total Tasks</strong><br>
          <span style="font-size: 24px; font-weight: bold;"><%= @report_data[:total_tasks] || 0 %></span>
        </div>
        
        <div style="background: white; padding: 15px; border-radius: 6px; border-left: 4px solid #28a745;">
          <strong>Progress</strong><br>
          <span style="font-size: 24px; font-weight: bold;"><%= @report_data[:progress_percentage] || 0 %>%</span>
        </div>
        
        <div style="background: white; padding: 15px; border-radius: 6px; border-left: 4px solid #6f42c1;">
          <strong>Project Status</strong><br>
          <span style="font-size: 18px; font-weight: bold;"><%= @report_data[:project_status] || 'Unknown' %></span>
        </div>
        
        <div style="background: white; padding: 15px; border-radius: 6px; border-left: 4px solid #fd7e14;">
          <strong>Completed Tasks</strong><br>
          <span style="font-size: 24px; font-weight: bold;"><%= @report_data[:completed_tasks] || 0 %></span>
        </div>
      </div>
      
      <% if @report_data[:tasks_by_status]&.any? %>
        <h3>Tasks by Status</h3>
        <ul>
          <% @report_data[:tasks_by_status].each do |status, count| %>
            <li><strong><%= status %>:</strong> <%= count %> tasks</li>
          <% end %>
        </ul>
      <% else %>
        <p>No tasks in this project yet.</p>
      <% end %>
      
      <% if @report_data[:recent_tasks]&.any? %>
        <h3>Recent Tasks</h3>
        <ul>
          <% @report_data[:recent_tasks].each do |task| %>
            <li>
              <strong><%= task[:title] %></strong> 
              - <%= task[:status] %> 
              <% if task[:due_date] %>| Due: <%= task[:due_date] %><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
    
    <p>
      <%= link_to 'View Project in TaskFlow Pro', project_url(@project), style: "background: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; display: inline-block;" %>
    </p>
    
    <p>Best regards,<br>The TaskFlow Pro Team</p>
    
    <p style="color: #6c757d; font-size: 12px; margin-top: 30px;">
      Report generated: <%= @report_data[:report_generated_at] %><br>
      Report ID: <%= @report_data[:report_id] %>
    </p>
  </body>
</html>