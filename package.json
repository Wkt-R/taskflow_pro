{
  "name": "app",
  "private": true,
  "devDependencies": {
    "coffeescript": "^2.7.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.18"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "esbuild app/javascript/application.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --watch",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --watch"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.20",
    "@popperjs/core": "2.11.8",
    "bootstrap": "^5.3.0",
    "jquery": "^3.7.0"
  }
}